    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "cdb2ffdf02a840e791f272afa700a07b",
    "m_Title": "에너지 보존 법칙",
    "m_Content": "나가는 빛의 양은 들어온 빛의 양을 넘을 수 없다.\n\n재질의 거칠기에 따라 난반사와 정반사의 비율이 결정되므로 정반사가 높아지면 그만큼 난반사는 줄어든다.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 1791.0,
        "y": 694.0,
